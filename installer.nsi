; BIT Typing — Windows installer (NSIS 3).
;
; Built by build_win.bat — always pass the Cargo.toml version explicitly:
;   makensis /DVERSION=2.1.0 installer.nsi
;
; Layout:
;   * Modern UI pages (welcome / per-user-or-all-users / directory / files).
;   * MultiUser.nsh handles elevation: admins get a per-machine install under
;     %ProgramFiles%, everyone else a per-user install under %LOCALAPPDATA%.
;     (Do NOT add RequestExecutionLevel here — MultiUser.nsh owns it.)
;   * install-info.json is written next to the EXE so the app keeps using the
;     per-user data dir (%LOCALAPPDATA%\BIT Typing) when installed.
;   * The uninstaller is generated by NSIS (WriteUninstaller): it kills a
;     running app, removes shortcuts (current + legacy names), registry keys,
;     and program files, with an optional checkbox for the per-user data dir.
!ifndef VERSION
  !error "Pass the app version: makensis /DVERSION=<Cargo.toml version> installer.nsi"
!endif

!ifndef APP_ICON
  !define APP_ICON "assets\favico.ico"
!endif
!define MUI_ICON "${APP_ICON}"
!define MUI_UNICON "${APP_ICON}"
!include "MUI2.nsh"
!include "LogicLib.nsh"
!include "FileFunc.nsh"
!include "StrFunc.nsh"
${Using:StrFunc} StrRep  ; Declare the installer-side StrRep function.
!include "nsDialogs.nsh"

!define APP_NAME "bit-typing"
!define APP_TITLE "BIT Typing"
!define APP_PUBLISHER "micr0softstore"
!define APP_URL "https://bitiskola.github.io/bit-typing"
!define APP_DATA_DIR "BIT Typing"
!define UNINSTALL_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\${APP_NAME}"

; ---- MultiUser (per-user vs all-users) -------------------------------------
!define MULTIUSER_EXECUTIONLEVEL Highest
!define MULTIUSER_MUI
!define MULTIUSER_INSTALLMODE_COMMANDLINE
!define MULTIUSER_INSTALLMODE_DEFAULT_ALLUSERS
!define MULTIUSER_INSTALLMODE_INSTDIR "${APP_NAME}"
!define MULTIUSER_INSTALLMODE_INSTDIR_REGISTRY_KEY "Software\${APP_NAME}"
!define MULTIUSER_INSTALLMODE_INSTDIR_REGISTRY_VALUENAME "InstallDir"
!include "MultiUser.nsh"

; ---- Installer metadata -----------------------------------------------------
Name "${APP_TITLE}"
OutFile "outputs\${APP_NAME}-setup.exe"
InstallDir "$PROGRAMFILES64\${APP_NAME}" ; MultiUser overrides this per mode.
BrandingText "${APP_TITLE} ${VERSION}"
VIProductVersion "${VERSION}.0"
VIAddVersionKey "ProductName" "${APP_TITLE}"
VIAddVersionKey "ProductVersion" "${VERSION}"
VIAddVersionKey "CompanyName" "${APP_PUBLISHER}"
VIAddVersionKey "FileDescription" "Modern typing practice application"
VIAddVersionKey "FileVersion" "${VERSION}"
SetCompressor /SOLID lzma

; ---- Pages ------------------------------------------------------------------
!define MUI_ABORTWARNING
!insertmacro MUI_PAGE_WELCOME
!insertmacro MULTIUSER_PAGE_INSTALLMODE
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_COMPONENTS
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
UninstPage custom un.DataPage un.DataLeave
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "English"

Function .onInit
  !insertmacro MULTIUSER_INIT
FunctionEnd

Function un.onInit
  !insertmacro MULTIUSER_UNINIT
FunctionEnd

; ---- Install ----------------------------------------------------------------
Section "Install application" SEC_MAIN
  SectionIn RO ; Always install the application; this cannot be deselected.
  ; Native registry view for machine installs (no-op otherwise).
  ${If} $MultiUser.Privileges == "Admin"
    SetRegView 64
  ${EndIf}

  SetOutPath "$INSTDIR"
  File "dist\${APP_NAME}.exe"
  SetOutPath "$INSTDIR\assets"
  File "assets\*.png"
  SetOutPath "$INSTDIR\keyboards"
  File "keyboards\*.json"
  SetOutPath "$INSTDIR\lang"
  File "lang\*.json"
  ; Lessons ship via git course packs (see details.json); the folder is still
  ; created for per-user custom lessons. No bundled *.txt is an error-free
  ; no-op for File wildcards, so this stays correct either way.

  ; install-info.json marks an installed (non-portable) layout for the app
  ; and records scope for tooling. Backslashes must be JSON-escaped.
  ${If} $MultiUser.InstallMode == "AllUsers"
    StrCpy $R1 "machine"
  ${Else}
    StrCpy $R1 "user"
  ${EndIf}
  ${StrRep} $R0 "$INSTDIR" "\" "\\"
  FileOpen $R2 "$INSTDIR\install-info.json" w
  FileWrite $R2 '{"app": "${APP_TITLE}",$\r$\n'
  FileWrite $R2 ' "version": "${VERSION}",$\r$\n'
  FileWrite $R2 ' "scope": "$R1",$\r$\n'
  FileWrite $R2 ' "install_dir": "$R0"}$\r$\n'
  FileClose $R2

  ; Remember a custom directory for reinstalls (read by MultiUser.nsh).
  WriteRegStr SHCTX "Software\${APP_NAME}" "InstallDir" "$INSTDIR"

  ; Shortcuts (shell folders follow the MultiUser context).
  CreateShortcut "$SMPROGRAMS\${APP_NAME}.lnk" "$INSTDIR\${APP_NAME}.exe" "" "$INSTDIR\${APP_NAME}.exe" 0

  ; Add/Remove Programs entry.
  WriteRegStr SHCTX "${UNINSTALL_KEY}" "DisplayName" "${APP_TITLE}"
  WriteRegStr SHCTX "${UNINSTALL_KEY}" "DisplayVersion" "${VERSION}"
  WriteRegStr SHCTX "${UNINSTALL_KEY}" "Publisher" "${APP_PUBLISHER}"
  WriteRegStr SHCTX "${UNINSTALL_KEY}" "InstallLocation" "$INSTDIR"
  WriteRegStr SHCTX "${UNINSTALL_KEY}" "DisplayIcon" "$INSTDIR\${APP_NAME}.exe,0"
  WriteRegStr SHCTX "${UNINSTALL_KEY}" "UninstallString" "$\"$INSTDIR\uninstall.exe$\""
  WriteRegStr SHCTX "${UNINSTALL_KEY}" "URLInfoAbout" "${APP_URL}"
  WriteRegDWORD SHCTX "${UNINSTALL_KEY}" "NoModify" 1
  WriteRegDWORD SHCTX "${UNINSTALL_KEY}" "NoRepair" 1
  ${GetSize} "$INSTDIR" "/S=0K" $R0 $R1 $R2
  WriteRegDWORD SHCTX "${UNINSTALL_KEY}" "EstimatedSize" $R0
  ${GetTime} "" "L" $R0 $R1 $R2 $R3 $R4 $R5 $R6
  StrCpy $R0 "$R2$R1$R0"
  WriteRegStr SHCTX "${UNINSTALL_KEY}" "InstallDate" "$R0"

  WriteUninstaller "$INSTDIR\uninstall.exe"
SectionEnd

; Desktop shortcut is selected by default in the Components page.
; Users can uncheck it without affecting the Start Menu shortcut.
Section "Create desktop shortcut" SEC_DESKTOP
  CreateShortcut "$DESKTOP\${APP_NAME}.lnk" "$INSTDIR\${APP_NAME}.exe" "" "$INSTDIR\${APP_NAME}.exe" 0
SectionEnd

; ---- Uninstall options page (optional per-user data removal) ----------------
Var DataCheckbox
Var RemoveUserData

Function un.DataPage
  nsDialogs::Create 1018
  Pop $0
  ${If} $0 == error
    Abort
  ${EndIf}
  ${NSD_CreateCheckbox} 0 10u 100% 12u "Also remove my courses, settings, and statistics"
  Pop $DataCheckbox
  ${NSD_SetState} $DataCheckbox 0
  ${NSD_CreateLabel} 0 26u 100% 12u "Keeps your learning progress for a future reinstall."
  Pop $0
  nsDialogs::Show
FunctionEnd

Function un.DataLeave
  ; NSD_GetState pushes 1 (checked) or 0 — compared literally so no extra
  ; header is needed for the BST_* defines.
  ${NSD_GetState} $DataCheckbox $RemoveUserData
FunctionEnd

; ---- Uninstall ---------------------------------------------------------------
Section "Uninstall"
  ${If} $MultiUser.Privileges == "Admin"
    SetRegView 64
  ${EndIf}

  ExecWait '"$SYSDIR\taskkill.exe" /F /T /IM ${APP_NAME}.exe'
  Sleep 1000

  Delete "$DESKTOP\${APP_NAME}.lnk"
  Delete "$DESKTOP\${APP_TITLE}.lnk"
  Delete "$SMPROGRAMS\${APP_NAME}.lnk"
  Delete "$SMPROGRAMS\${APP_TITLE}.lnk"
  DeleteRegKey SHCTX "${UNINSTALL_KEY}"
  DeleteRegKey SHCTX "Software\Microsoft\Windows\CurrentVersion\Uninstall\${APP_TITLE}"

  Delete "$INSTDIR\${APP_NAME}.exe"
  Delete "$INSTDIR\uninstall.exe"
  Delete "$INSTDIR\install-info.json"
  RMDir /r "$INSTDIR\assets"
  RMDir /r "$INSTDIR\keyboards"
  RMDir /r "$INSTDIR\courses"
  RMDir /r "$INSTDIR\lang"
  DeleteRegKey SHCTX "Software\${APP_NAME}"
  RMDir "$INSTDIR" ; only succeeds when empty (user files stay put)

  ${If} $RemoveUserData == 1
    RMDir /r "$LOCALAPPDATA\${APP_DATA_DIR}"
  ${EndIf}
SectionEnd
